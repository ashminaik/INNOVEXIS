# Environment Variables Example - Backend
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# MongoDB Configuration
# Get your MongoDB URI from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/database-name?appName=Cluster0

# AssemblyAI Configuration
# Get your API key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your-api-key-here

# JWT Configuration
# Use a strong secret key for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
